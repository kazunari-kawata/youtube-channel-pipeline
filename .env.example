# このファイルをコピーして .env を作り、値を入れてください（.env はGitに入りません）
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac / Linux:           cp .env.example .env

# ElevenLabs（https://elevenlabs.io/app/settings/api-keys で発行）
ELEVENLABS_API_KEY=

# YouTube Data API（アップロード自動化を始めるときに使う。今は空でよい）
# OAuthクライアントのJSONは secrets/ に置く（このフォルダもGitに入りません）
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
